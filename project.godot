; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[ai_assistant]

base_url="https://api.deepseek.com"
api_key=""
model="deepseek-chat"
temperature=1.0
max_tokens=0
stream=true
timeout=60.0
system_prompt=""

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Godot AI Assistant"
run/main_scene="res://examples/npc_chat_demo.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://project_icon.svg"

[autoload]

AI="*res://addons/ai_assistant/autoload/global_ai_chat.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/ai_assistant/plugin.cfg")
